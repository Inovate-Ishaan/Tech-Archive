generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User stores the institute email, password hash, and profile metadata.
model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String   @unique
  password      String?
  displayname   String
  avatar        String?
  bio           String?
  branch        String?
  year          Int?
  github        String?
  linkedin      String?
  website       String?
  emailVerified Boolean  @default(false)
  tokenVersion  Int      @default(0)
  posts         Post[]
  bookmarks     Bookmark[]
  instituteId   String   @unique
  otps          Otp[]
  createdAt     DateTime @default(now())
}

// Stores OTP for verification
model Otp {
  id        String     @id @default(uuid())
  email     String
  code      String
  used      Boolean    @default(false)
  expiresAt DateTime
  userId    String?
  user      User?      @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())
}

model Post {

  id          String   @id @default(uuid())
  title       String
  content     String
  coverImage  String?
  githubUrl   String?
  images      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  tags        PostTag[]
  bookmarks   Bookmark[]
}

model Tags {

  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  posts       PostTag[]
}

model PostTag {

  postId      String
  tagId       String
  post        Post    @relation(fields:[postId], references:[id])
  tags        Tags    @relation(fields:[tagId], references:[id])
  @@id([postId, tagId])
}

model Bookmark {

  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  username    String
  postId      String
  user        User     @relation(fields:[username], references:[username])
  post        Post     @relation(fields:[postId], references:[id])
  @@unique([username, postId])
}